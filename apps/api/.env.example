DATABASE_URL=postgresql://postgres:postgres@localhost:55432/chosn_dev
REDIS_URL=redis://localhost:6380
SENTRY_DSN=
WEB_ORIGIN=http://localhost:3000
PORT=4000

# pg Pool size (default 20 — see db.provider.ts for why the node-postgres
# default of 10 wasn't enough under Day 11's load test). Tune down if
# the Postgres plan's own connection ceiling is lower than expected.
PG_POOL_MAX=

# Transactional email (waitlist confirmation) — Resend. Unset = no-op,
# same convention as SENTRY_DSN/POSTHOG_KEY above; the endpoint still
# works end-to-end without these, it just skips sending the email.
RESEND_API_KEY=
RESEND_FROM=CHOSN <hello@chosn.app>

# Flipkart affiliate API (Day 1 §01 Tier 1 source). Unset = the adapter
# runs against fixtures instead of live HTTP, and says so on boot —
# same no-op-until-configured convention as SENTRY_DSN/RESEND_API_KEY.
FLIPKART_AFFILIATE_ID=
FLIPKART_AFFILIATE_TOKEN=

# Set to "off" to stop the price-fetch schedulers registering on boot.
PRICE_FETCH_SCHEDULE=

# Day 7 affiliate networks. Each is unset = that adapter runs on fixtures
# and reports mode:"fixture" at GET /health/fetch, so fixture data is
# never mistaken for real pricing.
ADMITAD_ACCESS_TOKEN=     # Myntra
ADMITAD_WEBSITE_ID=
INRDEALS_API_TOKEN=       # Ajio
INRDEALS_PUBLISHER_ID=
AWIN_API_TOKEN=           # END. Clothing
AWIN_PUBLISHER_ID=

# Set to "off" to silence the hourly pipeline health summary.
FETCH_HEALTH_LOG=

# Set to "off" to stop the Day 9 Market Intelligence hourly refresh
# (current/best/avg30/avg90/trend/signal) registering on boot.
MARKET_INTELLIGENCE_SCHEDULE=

# Day 13 drop scheduler — how often (minutes) it polls drop_events for
# anything due to flip 'live'. Default 1. Set DROP_SCHEDULER_SCHEDULE=off
# to stop it registering on boot (same convention as PRICE_FETCH_SCHEDULE).
DROP_SCHEDULER_INTERVAL_MINUTES=
DROP_SCHEDULER_SCHEDULE=

# Day 14 web push. Unset = WebPushService runs in no-op mode (same
# convention as RESEND_API_KEY) — the pipeline still runs end-to-end,
# push sends just report "not configured" instead of delivering.
# Generate a pair with: node -e "console.log(require('web-push').generateVAPIDKeys())"
# VAPID_PUBLIC_KEY is also served at GET /notifications/vapid-public-key
# for the frontend's pushManager.subscribe() call.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:hello@chosn.app

# Day 16 — verifies the short-lived Bearer token apps/web mints after
# login (apps/web/src/lib/auth/api-token.ts). Must be set to the exact
# same value as apps/web's API_JWT_SECRET, or every token fails
# verification. Unset means every WebSocket connection is treated as
# anonymous (DropLiveGateway) — and, as of Day 17, every trust-safety
# endpoint (filing a report, blocking a user, the moderation admin
# view) returns 401, since those routes are the first ones that
# actually require a verified caller. See src/auth/api-auth.guard.ts.
API_JWT_SECRET=

# Day 26 — object storage for Legit Check photo uploads
# (community/storage.service.ts). All five required — there is no
# local-disk fallback once this is set up; the app fails loud at boot if
# any are missing. Cloudflare R2 is preferred (S3-compatible, no egress
# fees for images next/image or a browser fetches directly):
#   STORAGE_BUCKET              the bucket name
#   STORAGE_ENDPOINT            R2: https://<account-id>.r2.cloudflarestorage.com
#                                S3: https://s3.<region>.amazonaws.com
#   STORAGE_ACCESS_KEY_ID       R2: dashboard -> R2 -> Manage API Tokens
#                                S3: an IAM user/role scoped to this bucket only
#   STORAGE_SECRET_ACCESS_KEY   paired with the access key above
#   STORAGE_REGION              R2: "auto" (ignored but required by the SDK). S3: the bucket's real region.
#   STORAGE_PUBLIC_BASE_URL     the URL images are actually served from —
#                                 an R2 custom domain, R2's own r2.dev
#                                 public-bucket URL, or an S3 bucket
#                                 website/CloudFront URL. Required: URLs
#                                 are written to post_images.url once at
#                                 upload time and never re-signed, so
#                                 this must be a stable, publicly
#                                 reachable base, not a signed URL.
STORAGE_BUCKET=
STORAGE_ENDPOINT=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
STORAGE_REGION=auto
STORAGE_PUBLIC_BASE_URL=

# Day 17 — toxicity pre-screening (apps/api/src/moderation/classifier.service.ts).
# Unset = classifyText() returns null and every caller treats that as
# "unavailable, don't block on it" — same no-op convention as every
# other optional integration above. Get a free key at
# https://developers.perspectiveapi.com/s/docs-get-started (needs a
# Google Cloud project — the account holder's own setup, same category
# as Day 16's Google OAuth credentials).
PERSPECTIVE_API_KEY=
