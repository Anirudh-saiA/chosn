# Public — bundled into the browser build. Never put a real secret here.
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Build-time only — read by next.config.mjs, never sent to the browser.
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
