# Public — bundled into the browser build. Never put a real secret here.
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Day 26 — optional override for the WebSocket base URL (lib/ws-url.ts),
# used by both the drops live-status gateway and community chat. Unset
# = derived from NEXT_PUBLIC_API_URL (ws/wss scheme swap), which is
# correct as long as the WebSocket gateway and the REST API are the
# same Railway service/domain, as they are today. Only set this if the
# gateway ever moves to a different host (e.g. wss://ws.chosn.app).
NEXT_PUBLIC_WS_URL=

# Day 16 — real accounts. Server-only below this line; none of these
# have a NEXT_PUBLIC_ prefix, so none of them are ever bundled into the
# browser (confirmed as part of the Day 16 secrets audit — see
# drops/README.md).

# apps/web is now a second direct Postgres client (Auth.js's adapter
# needs one) — same database apps/api migrates and uses, not a
# separate one. See lib/auth/db.ts for why.
DATABASE_URL=postgresql://postgres:postgres@localhost:55432/chosn_dev
# Sliding-window auth rate limiting (lib/auth/rate-limit.ts) — same
# Redis instance apps/api already uses, different keyspace prefix.
REDIS_URL=redis://localhost:6380

# NextAuth's own cookie-encryption key. Generate with:
#   npx auth secret
# or: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=
# Only needed if the deployed URL can't be inferred (Vercel sets this
# automatically in production) — set for local dev.
AUTH_URL=http://localhost:3000

# Google OAuth (task 1's chosen provider — see drops/README.md's Day 16
# section for why Google over the alternatives). Create credentials at
# https://console.cloud.google.com/apis/credentials — Authorized
# redirect URI: <AUTH_URL>/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Signs the short-lived Bearer token apps/web mints for calling
# apps/api (lib/auth/api-token.ts) — deliberately a *different* secret
# from AUTH_SECRET (NextAuth's own cookie key) and AUTH_API_JWT_SECRET
# must be set identically on apps/api too, or the API can't verify it.
# Generate the same way as AUTH_SECRET above.
API_JWT_SECRET=

# Encrypts the TOTP secret at rest via pgcrypto (lib/auth/totp.ts) —
# a stolen database dump alone can't produce working 2FA codes without
# this. Generate the same way as AUTH_SECRET above. Losing this key
# after users have enrolled in 2FA locks them all out of MFA (not of
# their accounts) — back it up like any other production secret.
TOTP_ENCRYPTION_KEY=

# Same no-op-until-configured convention as apps/api (RESEND_API_KEY) —
# password reset works end-to-end either way, it just logs the link
# instead of emailing it until a real key exists.
RESEND_API_KEY=
RESEND_FROM=CHOSN <hello@chosn.app>

