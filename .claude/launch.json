{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "chosn-web",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev",
        "--workspace=apps/web"
      ],
      "port": 3000
    },
    {
      "name": "chosn-web-open",
      "runtimeExecutable": "cmd",
      "runtimeArgs": [
        "/c",
        "cd apps/web && set COMING_SOON=off&& npx next dev -p 3002"
      ],
      "port": 3002
    }
  ]
}