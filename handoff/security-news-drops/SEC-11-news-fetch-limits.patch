diff --git a/apps/api/src/scripts/limited-fetch.spec.ts b/apps/api/src/scripts/limited-fetch.spec.ts
new file mode 100644
index 0000000..01efd30
--- /dev/null
+++ b/apps/api/src/scripts/limited-fetch.spec.ts
@@ -0,0 +1,37 @@
+import { createServer, type Server } from 'node:http';
+import type { AddressInfo } from 'node:net';
+import { afterAll, beforeAll, describe, expect, it } from 'vitest';
+import { fetchLimited } from './limited-fetch';
+
+let server: Server;
+let base = '';
+beforeAll(async () => {
+  server = createServer((req, res) => {
+    if (req.url === '/ok') return void res.end('<rss>fine</rss>');
+    if (req.url === '/404') return void res.writeHead(404).end();
+    if (req.url === '/big') return void res.end('x'.repeat(5000));
+    if (req.url === '/stall') return void res.writeHead(200).write('<rss>'); // never ends
+    res.end();
+  });
+  await new Promise<void>((r) => server.listen(0, '127.0.0.1', r));
+  base = `http://127.0.0.1:${(server.address() as AddressInfo).port}`;
+});
+afterAll(() => {
+  server.closeAllConnections();
+  server.close();
+});
+
+describe('fetchLimited', () => {
+  it('returns the text of a normal response', async () => {
+    expect(await fetchLimited(`${base}/ok`)).toEqual({ ok: true, status: 200, text: '<rss>fine</rss>' });
+  });
+  it('reports a bad status without throwing', async () => {
+    expect((await fetchLimited(`${base}/404`)).ok).toBe(false);
+  });
+  it('refuses a body over the size limit', async () => {
+    await expect(fetchLimited(`${base}/big`, {}, { maxBytes: 1000 })).rejects.toThrow(/too large/);
+  });
+  it('gives up on a response that never finishes', async () => {
+    await expect(fetchLimited(`${base}/stall`, {}, { timeoutMs: 300 })).rejects.toThrow();
+  });
+});
diff --git a/apps/api/src/scripts/limited-fetch.ts b/apps/api/src/scripts/limited-fetch.ts
new file mode 100644
index 0000000..919a4f7
--- /dev/null
+++ b/apps/api/src/scripts/limited-fetch.ts
@@ -0,0 +1,34 @@
+/**
+ * GET a page as text with a time limit and a size limit, so one stalled or hostile feed cannot block the whole news run or fill memory.
+ * Throws on timeout, on a body over `maxBytes`, and (via the caller's own check) on a bad status.
+ */
+export async function fetchLimited(
+  url: string,
+  init: RequestInit = {},
+  { timeoutMs = 20_000, maxBytes = 3_000_000 }: { timeoutMs?: number; maxBytes?: number } = {},
+): Promise<{ ok: boolean; status: number; text: string }> {
+  const res = await fetch(url, { ...init, signal: AbortSignal.timeout(timeoutMs) });
+  if (!res.ok) {
+    await res.body?.cancel();
+    return { ok: false, status: res.status, text: '' };
+  }
+  const declared = Number(res.headers.get('content-length') ?? 0);
+  if (declared > maxBytes) {
+    await res.body?.cancel();
+    throw new Error(`response too large (${declared} bytes, limit ${maxBytes})`);
+  }
+  const reader = res.body?.getReader();
+  const chunks: Uint8Array[] = [];
+  let total = 0;
+  while (reader) {
+    const { done, value } = await reader.read();
+    if (done) break;
+    total += value.byteLength;
+    if (total > maxBytes) {
+      await reader.cancel();
+      throw new Error(`response too large (over ${maxBytes} bytes)`);
+    }
+    chunks.push(value);
+  }
+  return { ok: true, status: res.status, text: Buffer.concat(chunks).toString('utf8') };
+}
